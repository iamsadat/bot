# JobHunt — personal settings.
#
#   cp me.env.example me.env      # me.env is gitignored; this repo is public
#   python -m jobhunt me          # opens http://127.0.0.1:8765
#
# Only JOBHUNT_ME_RESUME is needed to start; everything else switches on a
# capability. `python -m jobhunt me` prints which ones are on at startup.

# ---- you -------------------------------------------------------------------
# Your résumé (.pdf/.docx/.txt). Your profile is built from it on first run;
# after that, edits on the Profile page win. Rebuild with `jobhunt me --reseed`.
JOBHUNT_ME_RESUME=~/Documents/resume.pdf
JOBHUNT_ME_ROLES=Data Engineer
JOBHUNT_ME_LOCATIONS=Hyderabad,Bangalore,Remote
# Read from the résumé when left blank:
JOBHUNT_ME_NAME=
JOBHUNT_ME_EMAIL=
JOBHUNT_ME_PHONE=

# ---- applying ----------------------------------------------------------------
# Co-pilot (default): approving a job opens its application in a browser,
# filled in from your profile, and you press Submit.
# Autonomous: matches above the floor are submitted for you, up to the cap.
# Both can also be changed on the dashboard's Autonomy panel.
JOBHUNT_ME_AUTO_APPLY=0
JOBHUNT_ME_RELEVANCE_FLOOR=0.75
JOBHUNT_ME_DAILY_CAP=5
# Browser filling needs: pip install playwright && playwright install chromium

# ---- job sources -------------------------------------------------------------
# Free at developer.adzuna.com — the main source of non-remote India roles.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- optional power-ups ------------------------------------------------------
# AI writing — résumé bullets, cover letters, interview prep, outreach — on
# your Claude Pro/Max plan, no API key: install Claude Code once and sign in.
#   npm install -g @anthropic-ai/claude-code && claude
# It's picked up automatically. Force or disable it with:
# JOBHUNT_LLM=claude-code      # or: none
# AI calls per sweep (top matches first; the rest use templates). 0 = no cap.
# JOBHUNT_LLM_CALLS_PER_SWEEP=40

# Phone notifications for new matches, applications and the daily digest.
# Create a bot with @BotFather, message it once, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
JOBHUNT_TELEGRAM_BOT_TOKEN=
JOBHUNT_TELEGRAM_CHAT_ID=

# Move applications forward automatically from recruiter emails (interview,
# assessment, offer, rejection). For Gmail use an app password:
# myaccount.google.com/apppasswords. Note: synced messages are marked read.
JOBHUNT_IMAP_HOST=imap.gmail.com
JOBHUNT_IMAP_USER=
JOBHUNT_IMAP_PASSWORD=

# Raises the GitHub project-import rate limit (60/hour without).
GITHUB_TOKEN=

# Protects the dashboard if you ever expose it beyond your machine.
JOBHUNT_ACCESS_CODE=

# ---- tuning (personal-mode defaults shown) -----------------------------------
# JOBHUNT_DISCOVERY_POLL_SECONDS=21600   # automatic sweep every 6 hours
# JOBHUNT_DIGEST_INTERVAL_SECONDS=86400  # daily digest (needs notifications)
# JOBHUNT_SHORTLIST_CAP=25               # résumés tailored per sweep
# JOBHUNT_AUTOFILL_HEADLESS=0            # co-pilot browser is visible
